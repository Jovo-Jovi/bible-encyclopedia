{"blocks":[{"t":"ar","x":"مزمور لسليمان عن أورشليم"},{"t":"ar","x":"(1) تكبّر الخاطئُ فقلب الأسوار المحصّنة، في العيد،"},{"t":"ar","x":"وأنت ما منعتَه!"},{"t":"ar","x":"(2) أممٌ غريبة صعدتْ على مذبحك،"},{"t":"ar","x":"وداستْهُ، كبرياءً، بنعالها."},{"t":"ar","x":"(3) نجّس بنو أورشليم مقدس الربّ،"},{"t":"ar","x":"ودنّسوا، في شرّهم، تقادمَهم لله."},{"t":"ar","x":"(4) لهذا قال: «أبعدوها عني،"},{"t":"ar","x":"فأنا لا أُسَرّ بها»."},{"t":"ar","x":"(5) بهاءُ مجد أورشليم"},{"t":"ar","x":"كلا شيء أمام الله،"},{"t":"ar","x":"فاحتُقرَ إلى النهاية."},{"t":"ar","x":"(6) بنوها وبناتها في سبي مرير:"},{"t":"ar","x":"خُتم عنقُهم بختم العبيد،"},{"t":"ar","x":"(وجُعل) عليهم نيرٌ وسطَ الأمم."},{"t":"ar","x":"(7) بحسب خطاياهم عاملَهم،"},{"t":"ar","x":"فأسملهم إلى أيدي مُضايقيهم."},{"t":"ar","x":"(8) رفض أن يرحمهم، فمال عنهم جميعاً،"},{"t":"ar","x":"شبّاناً وشيوخاً مع أولادهم:"},{"t":"ar","x":"كلُّهم فعلوا الشرّ وما سمعوا."},{"t":"ar","x":"(9) تلبّدت السماء بالغضب، والأرضُ مقتَتْهم،"},{"t":"ar","x":"لأن أحداً لم يفعل ما فعلوا."},{"t":"ar","x":"(10) عرفت الأرضُ كلها،"},{"t":"ar","x":"برّ أحكامك، يا الله."},{"t":"ar","x":"(11) صار بنو أورشليم أضحوكة."},{"t":"ar","x":"هو عقابُ الزنى الذي يُصنع فيها:"},{"t":"ar","x":"فمن تجاوز الوصيّة تجاوزها في وضح النهار."},{"t":"ar","x":"(12) أثِموا فضحكوا، كعادتهم،"},{"t":"ar","x":"وفي وضح النهار نشروا شرورهم."},{"t":"ar","x":"(13) حكمتَ فتنجّستْ بناتُ أورشليم،"},{"t":"ar","x":"لأنهنّ تدنّسن بزواجات محرّمة."},{"t":"ar","x":"(14) حين شاهدتُ هذا،"},{"t":"ar","x":"تألّمتُ في صدري وفي أحشائي."},{"t":"ar","x":"(15) بقلب مستقيم، أعلنتُ برَّك، يا الله،"},{"t":"ar","x":"فبرُّك ظاهرٌ في أحكامك، يا الله."},{"t":"ar","x":"(16) جازيتَ الخطأةَ على أعمالهم،"},{"t":"ar","x":"وعلى خطاياهم الشنيعة."},{"t":"ar","x":"(17) كشفتَ خطاياهم فبان حكمُك،"},{"t":"ar","x":"ومن الأرض محوتَ ذكرَهم."},{"t":"ar","x":"(18) الله ديّان عادل،"},{"t":"ar","x":"لا يقضي بما ترى عيناه."},{"t":"ar","x":"(19) أذلّوا أورشليم وداسوها بالأقدام،"},{"t":"ar","x":"فانتُزع جمالُها عن عرشها المجيد."},{"t":"ar","x":"(20) لبست المسحَ، لا لباس البهاء،"},{"t":"ar","x":"وكلّلت رأسها بالحَبْل، لا بالاكليل."},{"t":"ar","x":"(21) تركتْ تاجاً مجيداً توَّجها به الله،"},{"t":"ar","x":"وبإزدراء طُرح بهاؤها على الأرض."},{"t":"ar","x":"(22) رأيتُ ذلك فتوسّلتُ إلى الربِّ وقلت:"},{"t":"ar","x":"\"ثقُلت يدُك على اسرائيل، يا ربّ،"},{"t":"ar","x":"فحرّكتَ الوثنيين."},{"t":"ar","x":"(23) فالغضب والسخط والحقد،"},{"t":"ar","x":"لم يوفّر لها الاحتقار."},{"t":"ar","x":"هم يُزيلونها، يا ربّ،"},{"t":"ar","x":"إن لم توبّخْهم في غضبك."},{"t":"ar","x":"(24) تصرّفوا طمعاً، لا غيرة،"},{"t":"ar","x":"فصبّوا علينا جنونهم وسلبوا."},{"t":"ar","x":"(25) لا تتأخّر، يا الله، لتُسقِطَه على رأسهم،"},{"t":"ar","x":"وحوّل إلى العار، كبرياء التنّين(17)»؟"},{"t":"ar","x":"(26) ما انتظرتُ ليريني الله عاره:"},{"t":"ar","x":"طُعن على جبال مصر،"},{"t":"ar","x":"وزال كأحقر انسان على الأرض والبحر."},{"t":"ar","x":"(27) تقاذفت جسدَه الأمواجُ، باحتقار كبير،"},{"t":"ar","x":"وما كان أحد ليدفنه."},{"t":"ar","x":"أزاله الله باحتقار."},{"t":"ar","x":"(28) ما فكّر أنه انسان،"},{"t":"ar","x":"ولا حسِبَ لنفسه هذه النهاية."},{"t":"ar","x":"(29) قال: «أنا سيّد الأرض والبحر»،"},{"t":"ar","x":"وما اعترف: «الربّ هو الله،"},{"t":"ar","x":"وهو العظيم والقدير والقوي\"."},{"t":"ar","x":"(30) فهوَ يملك على السماء والأرض،"},{"t":"ar","x":"ويدين الملوك والممالك."},{"t":"ar","x":"(31) هو يُنهضني ليُمجّدني،"},{"t":"ar","x":"ويسحق المتكبّرين في العار،"},{"t":"ar","x":"من أجل الهلاك الأبديّ،"},{"t":"ar","x":"لأنهم لم يعرفوه."},{"t":"ar","x":"(32) فالآن، يا عظماء الأرض،"},{"t":"ar","x":"أنظروا دينونةَ الربّ."},{"t":"ar","x":"هو ملكٌ عظيم وعادل،"},{"t":"ar","x":"يدين كلَّ ما تحت السماء."},{"t":"ar","x":"(33) باركوا الله،"},{"t":"ar","x":"يا من تخافون الربّ وتعرفونه."},{"t":"ar","x":"فالربّ حين يدين،"},{"t":"ar","x":"يرحم الذين يخافونه."},{"t":"ar","x":"(34) فيفصل البارّ عن الخاطئ،"},{"t":"ar","x":"ويجازي الخطأة على أعمالهم، إلى الأبد."},{"t":"ar","x":"(35) يتحنّن على البار الذي أذلّه الخاطئ،"},{"t":"ar","x":"ويجازي الخاطئ على ما فعله للبار."},{"t":"ar","x":"(36) الربّ عذبٌ هو"},{"t":"ar","x":"للذين يدعونه ويرجونه."},{"t":"ar","x":"يعامل الأتقياء بحسب رحمته،"},{"t":"ar","x":"ليكونوا أقوياء، أمامه، على الدوام."},{"t":"ar","x":"(37) ليكن الربّ مباركاً (بفم) عبيده."}]}