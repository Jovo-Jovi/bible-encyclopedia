{"blocks":[{"t":"ar","x":"المزمور الثالث"},{"t":"ar","x":"المزمور الثالث"},{"t":"ar","x":"مزمور لسليمان، الأبرار"},{"t":"ar","x":"(1) لماذا تنامين، يا نفسي،"},{"t":"ar","x":"لماذا لا تباركين الربّ؟"},{"t":"ar","x":"أنشدي نشيداً جديداً،"},{"t":"ar","x":"لإله يجب أن نمدحه."},{"t":"ar","x":"(2) أنشدي واسهري سهراً،"},{"t":"ar","x":"فالله يستعذب مزموراً"},{"t":"ar","x":"يصعدُ من قلب طيّب."},{"t":"ar","x":"(3) الأبرارُ يتذكّرون الربّ على الدوام،"},{"t":"ar","x":"يُنشدون أحكام الربّ ويُعلنون برّه."},{"t":"ar","x":"(4) البارّ لا يرفض عقاب الربّ،"},{"t":"ar","x":"ويوافق دوماً على ما يريده الربّ."},{"t":"ar","x":"(5) عثر البارّ فأعلن أن الربّ بار،"},{"t":"ar","x":"سقط فانتظرت عيناه تدخّلَ الله."},{"t":"ar","x":"(6) الأبرار يَثقون بالله مخلّصهم،"},{"t":"ar","x":"ففي بيت البار لا ملجأ لخطايا تتكدّس."},{"t":"ar","x":"(7) البار يراقب بيته على الدوام،"},{"t":"ar","x":"لينزع منه الاثم والمخالفات."},{"t":"ar","x":"(8) يفتدي بالصوم والعناء خطايا لم نتنبّه لها."},{"t":"ar","x":"والربّ ينقّي جميعَ الأتقياء وبيوتَهم."},{"t":"ar","x":"(9) عثر الخاطئ فلعن الحياة،"},{"t":"ar","x":"ويوماً ولدتْه فيه أمُّه."},{"t":"ar","x":"(10) كدّس الخطايا طوال حياته،"},{"t":"ar","x":"فسقط، وما قام، سقطة مميتة."},{"t":"ar","x":"(11) هلاكُ الخاطئ هلاك أبديّ،"},{"t":"ar","x":"فلا يذكره الربّ حين يزور الأبرار."},{"t":"ar","x":"(12) ذاك هو حظّ الخطأة إلى الأبد."},{"t":"ar","x":"أما خائفو الربّ فيقومون للحياة الأبديّة،"},{"t":"ar","x":"وحياتهم، في نور الربّ، لا نهاية لها."}]}