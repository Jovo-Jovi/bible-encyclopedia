{"blocks":[{"t":"ar","x":"شعر شق بن صعب"},{"t":"ar","x":"شعر شق بن صعب"},{"t":"ar","x":"(المرجع: العرب قبل الاسلام- سيد القمنى)"},{"t":"ar","x":"يتحدث عن عن يوم الحساب والميقات ويعد المؤمنين والابرار بالفوز والخيرات"},{"t":"ar","x":"يوم تجزي فيه الولايات،"},{"t":"ar","x":"يدعى فيه من السماء بدعوات،"},{"t":"ar","x":"يسمع منها الاحياء والاموات،"},{"t":"ar","x":"ويجمع فيه الناس للميقات،"},{"t":"ar","x":"يكون فيه لمن اتقى الفوز والخيرات"},{"t":"ar","x":"ويقسم لسامعه ان ما يقوله ليس الا الحق"},{"t":"ar","x":"ورب السماء والارض،"},{"t":"ar","x":"وما بينهما من رفع وخفض،"},{"t":"ar","x":"ان ما أنبتك به لحق، ما فيه امض"}]}