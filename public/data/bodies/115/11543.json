{"blocks":[{"t":"ar","x":"نؤمن باله واحد،"},{"t":"ar","x":"اب ضابط الكل،"},{"t":"ar","x":"خالق السماوات والارض،"},{"t":"ar","x":"كل ما يرى وما لا يرى."},{"t":"ar","x":"وبرب واحد يسوع المسيح،"},{"t":"ar","x":"ابن الله الوحيد،"},{"t":"ar","x":"المولود من الاب،"},{"t":"ar","x":"اله حق قيل كل الدهور،"},{"t":"ar","x":"الذى به كان كل شى،"},{"t":"ar","x":"وصار انسان من مريم العذراء، ومن الروح القدس،"},{"t":"ar","x":"وصلب وقام فى اليوم الثالث،"},{"t":"ar","x":"وصعد الى السماء وجلس عن يمين ابين الاب،"},{"t":"ar","x":"وسياتى بمجد ليدين الاحياء والاموات،"},{"t":"ar","x":"الذى لا فناء لملكه."},{"t":"ar","x":"وبالروح القدس الواحد، المعزى،"},{"t":"ar","x":"الذى نطق بالانبياء."},{"t":"ar","x":"وبمعمودية واحدة للتوبة ولمغفرة الخطايا."},{"t":"ar","x":"وبكنيسة واحدة، مقدسة، جامعة."},{"t":"ar","x":"وبقيامة الجسد."},{"t":"ar","x":"وبالحياة الابدية."}]}