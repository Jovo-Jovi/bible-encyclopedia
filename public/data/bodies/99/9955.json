{"blocks":[{"t":"ar","x":"ثقتى فى التوراة والإنجيل"},{"t":"ar","x":"ثقتى فى التوراة والإنجيل"},{"t":"ar","x":"بقلم جوش مكدويل"},{"t":"ar","x":"ترجمة القس منيس عبد النور"},{"t":"ar","x":"الفهرس"},{"t":"ar","x":"مقدمة"},{"t":"ar","x":"الفصل الأول - الكتاب الفريد"},{"t":"ar","x":"1- في ترابطه"},{"t":"ar","x":"2- في توزيعه"},{"t":"ar","x":"3- في ترجمته"},{"t":"ar","x":"4- في بقائه"},{"t":"ar","x":"5-في تعليمه"},{"t":"ar","x":"6- في تأثيره على الأدب"},{"t":"ar","x":"الفصل الثاني - كيف كُتب الكتاب المقدس?"},{"t":"ar","x":"1- المواد المستعملة في كتابة الكتابة المقدس"},{"t":"ar","x":"2- أشكال الكتاب القديمة"},{"t":"ar","x":"3- أنواع الكتابة"},{"t":"ar","x":"4- أقسام الكتاب المقدس"},{"t":"ar","x":"الفصل الثالث الأسفار القانونية"},{"t":"ar","x":"1- قانونية السفر"},{"t":"ar","x":"2- قانونية العهد القديم"},{"t":"ar","x":"3- قانونية أسفار العهد الجديد"},{"t":"ar","x":"الفصل الرابع الكتاب الذي يُعتمد عليه"},{"t":"ar","x":"صحة الكتاب المقدس ببليوغرافيا"},{"t":"ar","x":"العهد الجديد:"},{"t":"ar","x":"1- شهادة علماء الببليوغرافيا للعهد الجديد"},{"t":"ar","x":"2- شهادة المخطوطات للعهد الجديد"},{"t":"ar","x":"3- الترتيب التاريخي لمخطوطات العهد الجديد"},{"t":"ar","x":"4- ترجمات العهد الجديد"},{"t":"ar","x":"5-علماء الكنيسة الأولون يشهدون للعهد الجديد"},{"t":"ar","x":"6- شاهد على صحة المخطوطات من تلاوتها بالكنائس"},{"t":"ar","x":"العهد القديم"},{"t":"ar","x":"1- الاهتمام الزائد بنقل المخطوطات"},{"t":"ar","x":"2- أشخاص متخصصون لنقل المخطوطات"},{"t":"ar","x":"3- مخطوطات قديمة للعهد القديم"},{"t":"ar","x":"4- ترجمات العهد القديم"},{"t":"ar","x":"5-اقتباسات من العهد القديم"},{"t":"ar","x":"براهين داخلية على صحة الكتاب المقدس"},{"t":"ar","x":"1- الشك في جانب المخطوطة"},{"t":"ar","x":"2- المراجع أساسية وقيمة"},{"t":"ar","x":"3- المراجع قديمة وأصلية"},{"t":"ar","x":"براهين خارجية على صحة الكتاب المقدس"},{"t":"ar","x":"براهين من علم الحفريات والآثار"},{"t":"ar","x":"1- نماذج من حفريات تبرهن صحة العهد القديم"},{"t":"ar","x":"2- نماذج من حفريات تبرهن صحة العهد الجديد"},{"t":"ar","x":"الفصل الخامس - الكتاب المقدس صادق في نبواته"},{"t":"ar","x":"1- مقدمة - تعريف بالنبوة"},{"t":"ar","x":"2- فحوص النبوة الصادقة"},{"t":"ar","x":"3- الاعتراض على النبوات"},{"t":"ar","x":"4- نبوات تحققت عن:"},{"t":"ar","x":"صور"},{"t":"ar","x":"صيدون"},{"t":"ar","x":"السامرة"},{"t":"ar","x":"غزة وأشقلون"},{"t":"ar","x":"موآب وعمون"},{"t":"ar","x":"البتراء وآدوم"},{"t":"ar","x":"طيبة وممفيس"},{"t":"ar","x":"نينوى"},{"t":"ar","x":"بابل"},{"t":"ar","x":"كورزين وبيت صيدا وكفرناحوم"},{"t":"ar","x":"اتساع أورشليم"},{"t":"ar","x":"فلسطين"},{"t":"ar","x":"5-الاحتمالات النبوية"},{"t":"ar","x":"مقدمة"},{"t":"ar","x":"قضى أستاذ جوش مكدويل اثنتين وأربعين سنة يدرس الكتب الشرقية وكتب بعد ذلك مقارنة بينها وبين الكتاب المقدس? قال فيها:"},{"t":"ar","x":"كّوِم هذه الكتب على جانب مكتبك الأيسر? إذا شئت. ولكن ضع كتابك المقدس علىالجانب الأيمن? وحده بمفرده? وبينه وبينها كلها مسافة. فهناك فعلا مسافة كبيرة تفصل هذا الكتاب الواحد عنها كلها فصلا كاملا وإلى الأبد. إنها ماسفة حقيقية لا يمكن أن يُقام عليها جسر - كوبري - من أي علم أو فكر ديني."}]}